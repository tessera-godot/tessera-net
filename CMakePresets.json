{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows (Visual Studio 2022)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-msvc",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-msvc-profile",
      "displayName": "Windows (Visual Studio 2022), stage timing and benchmark",
      "inherits": "windows-msvc",
      "binaryDir": "${sourceDir}/build/windows-msvc-profile",
      "cacheVariables": {
        "TESSERA_PROFILE": "ON",
        "TESSERA_BUILD_BENCH": "ON"
      }
    },
    {
      "name": "windows-msvc-server",
      "displayName": "Windows (Visual Studio 2022), server library and its tests",
      "inherits": "windows-msvc",
      "binaryDir": "${sourceDir}/build/windows-msvc-server",
      "cacheVariables": {
        "TESSERA_BUILD_SERVER": "ON"
      }
    },
    {
      "name": "windows-msvc-enet",
      "displayName": "Windows (Visual Studio 2022), server, ENet transport and head-to-head programs",
      "inherits": "windows-msvc",
      "binaryDir": "${sourceDir}/build/windows-msvc-enet",
      "cacheVariables": {
        "TESSERA_BUILD_SERVER": "ON",
        "TESSERA_BUILD_ENET": "ON",
        "TESSERA_BUILD_BENCH": "ON"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux (Ninja, Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux (Ninja, Debug)",
      "inherits": "linux-release",
      "binaryDir": "${sourceDir}/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-server-release",
      "displayName": "Linux (Ninja, Release), server library and its tests",
      "inherits": "linux-release",
      "binaryDir": "${sourceDir}/build/linux-server-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TESSERA_BUILD_SERVER": "ON"
      }
    },
    {
      "name": "linux-server-debug",
      "displayName": "Linux (Ninja, Debug), server library and its tests",
      "inherits": "linux-release",
      "binaryDir": "${sourceDir}/build/linux-server-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TESSERA_BUILD_SERVER": "ON"
      }
    },
    {
      "name": "linux-enet-release",
      "displayName": "Linux (Ninja, Release), server, ENet transport and example server",
      "inherits": "linux-release",
      "binaryDir": "${sourceDir}/build/linux-enet-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TESSERA_BUILD_SERVER": "ON",
        "TESSERA_BUILD_ENET": "ON"
      }
    },
    {
      "name": "linux-enet-debug",
      "displayName": "Linux (Ninja, Debug), server, ENet transport and example server",
      "inherits": "linux-release",
      "binaryDir": "${sourceDir}/build/linux-enet-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TESSERA_BUILD_SERVER": "ON",
        "TESSERA_BUILD_ENET": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    },
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-profile-release",
      "configurePreset": "windows-msvc-profile",
      "configuration": "Release"
    },
    {
      "name": "windows-msvc-server-release",
      "configurePreset": "windows-msvc-server",
      "configuration": "Release"
    },
    {
      "name": "windows-msvc-server-debug",
      "configurePreset": "windows-msvc-server",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-enet-release",
      "configurePreset": "windows-msvc-enet",
      "configuration": "Release"
    },
    {
      "name": "windows-msvc-enet-debug",
      "configurePreset": "windows-msvc-enet",
      "configuration": "Debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-server-release",
      "configurePreset": "linux-server-release"
    },
    {
      "name": "linux-server-debug",
      "configurePreset": "linux-server-debug"
    },
    {
      "name": "linux-enet-release",
      "configurePreset": "linux-enet-release"
    },
    {
      "name": "linux-enet-debug",
      "configurePreset": "linux-enet-debug"
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-profile-release",
      "configurePreset": "windows-msvc-profile",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-server-release",
      "configurePreset": "windows-msvc-server",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-server-debug",
      "configurePreset": "windows-msvc-server",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-enet-release",
      "configurePreset": "windows-msvc-enet",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-enet-debug",
      "configurePreset": "windows-msvc-enet",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-server-release",
      "configurePreset": "linux-server-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-server-debug",
      "configurePreset": "linux-server-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-enet-release",
      "configurePreset": "linux-enet-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-enet-debug",
      "configurePreset": "linux-enet-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
