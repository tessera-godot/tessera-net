[configuration]

entry_symbol = "tessera_net_init"
compatibility_minimum = "4.5"

[libraries]

windows.debug.x86_64 = "res://bin/libtessera_net.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libtessera_net.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libtessera_net.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libtessera_net.linux.template_release.x86_64.so"
